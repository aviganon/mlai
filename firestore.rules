rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true if the caller is the business owner OR is a member
    // whose mlaiUsers doc points to this business.
    function isMember(businessId) {
      return request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/mlaiUsers/$(request.auth.uid)).data.businessId == businessId
      );
    }

    // Helper: true if the caller has isOwner: true in their mlaiUsers doc.
    function isMlaiOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/mlaiUsers/$(request.auth.uid)).data.isOwner == true;
    }

    // mlaiDomains – only mlai owners
    match /mlaiDomains/{domainId} {
      allow read, write, delete: if isMlaiOwner();
    }

    // mlaiUsers – own doc OR mlai owner
    match /mlaiUsers/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isMlaiOwner());
      allow create: if request.auth != null && (request.auth.uid == userId || isMlaiOwner());
      allow update, delete: if request.auth != null && (request.auth.uid == userId || isMlaiOwner());
    }

    // businesses – owner or member OR mlai owner
    match /businesses/{businessId} {
      allow create: if request.auth != null;
      allow read, write, delete: if isMlaiOwner() || isMember(businessId);

      match /items/{itemId} {
        allow read, write, delete: if isMlaiOwner() || isMember(businessId);
      }

      match /purchaseOrders/{orderId} {
        allow read, write, delete: if isMlaiOwner() || isMember(businessId);
      }

      match /supplierDetails/{supplierId} {
        allow read, write, delete: if isMlaiOwner() || isMember(businessId);
      }

      match /{subcollection}/{docId} {
        allow read, write, delete: if isMlaiOwner() || isMember(businessId);
      }
    }

    // mlaiConfig – readable by anyone (for registration code validation),
    // writable only by mlai owners.
    match /mlaiConfig/{docId} {
      allow read: if true;
      allow write: if isMlaiOwner();
    }
  }
}
